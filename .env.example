# BioSense Platform - Environment Configuration Example
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=biosense-secure-random-dev-secret-key-change-in-prod-2026
DATABASE_URL=sqlite:///biosense.db

# Storage Limits
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
UPLOAD_FOLDER=uploads
MODEL_FOLDER=models
